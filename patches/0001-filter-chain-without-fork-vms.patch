+#ifdef __VMS
+/* OpenVMS has no fork(), so the filter chain cannot run as a pipeline of
+   processes.  Every stage reads all its input before it ends, so on VMS the
+   stages run one after another over temporary files in SYS$SCRATCH when
+   flex has finished writing: filter_apply_chain() only diverts flex's
+   output to a file and remembers where the real output goes, and
+   filter_vms_finish() (called from flex_main() at the end) runs the chain:
+   tee_header splits the C file and the header, and each goes through m4
+   (a separate process, started with vfork() and execv()) and fix_linedirs
+   (here, in flex).  */
+
+static struct filter *vms_chain;	/* the chain to run at the end */
+static int vms_out_fd = -1;		/* the real output (-o file or stdout) */
+static char vms_raw_name[80];		/* flex's own output */
+
+static void vms_tmp_name (char *buf, size_t size, const char *what)
+{
+	static unsigned int counter;
+	snprintf (buf, size, "SYS$SCRATCH:FLEX_%08X_%u_%s.TMP",
+		  (unsigned int) getpid (), ++counter, what);
+}
+
+/* Delete every version of NAME (a subprocess can leave a new version of a
+   file redirected to it).  */
+static void vms_delete_all (const char *name)
+{
+	char spec[96];
+	struct dsc$descriptor_s d;
+	snprintf (spec, sizeof spec, "%s;*", name);
+	d.dsc$w_length = (unsigned short) strlen (spec);
+	d.dsc$b_dtype = DSC$K_DTYPE_T;
+	d.dsc$b_class = DSC$K_CLASS_S;
+	d.dsc$a_pointer = spec;
+	lib$delete_file (&d, 0, 0, 0, 0, 0, 0, 0, 0, 0);
+}
+
+/* Errors here cannot go through flexerror(), which would longjmp back into
+   the end of flex_main() that called us.  */
+static void vms_filter_error (const char *what, const char *name)
+{
+	fprintf (stderr, "%s: %s %s\n", program_name, what, name);
+}
+
+/* Run the external filter F (m4) with the file IN as its standard input
+   and the file OUT as its standard output.  0 on success.  */
+static int vms_run_ext (struct filter *f, const char *in, const char *out)
+{
+	int     in_fd, out_fd, saved_in, saved_out, wstatus = 0;
+	pid_t   pid;
+	FILE   *o;
+
+	in_fd = open (in, O_RDONLY);
+	o = fopen (out, "w");
+	if (in_fd < 0 || o == NULL) {
+		vms_filter_error (_("cannot create temporary file"), out);
+		if (in_fd >= 0)
+			close (in_fd);
+		if (o)
+			fclose (o);
+		return -1;
+	}
+	out_fd = fileno (o);
+	fflush (stderr);
+	saved_in = dup (0);
+	saved_out = dup (1);
+	dup2 (in_fd, 0);
+	dup2 (out_fd, 1);
+	pid = vfork ();
+	if (pid == 0) {
+		/* On VMS vfork() creates no process; execv() does, and if it
+		   fails it returns here, in flex.  */
+		execv (f->argv[0], (char **) f->argv);
+		pid = -1;
+	}
+	if (saved_in >= 0) {
+		dup2 (saved_in, 0);
+		close (saved_in);
+	}
+	if (saved_out >= 0) {
+		dup2 (saved_out, 1);
+		close (saved_out);
+	}
+	close (in_fd);
+	fclose (o);
+	if (pid < 0) {
+		vms_filter_error (_("cannot run"), f->argv[0]);
+		return -1;
+	}
+	if (waitpid (pid, &wstatus, 0) != pid
+	    || !WIFEXITED (wstatus) || WEXITSTATUS (wstatus) != 0) {
+		vms_filter_error (_("failed:"), f->argv[0]);
+		return -1;
+	}
+	return 0;
+}
+
+/* Run the chain from F over the file IN, writing the result to FINAL.  */
+static int vms_run_chain (struct filter *f, const char *in, FILE *final)
+{
+	char    cur[80], next[80];
+	FILE   *i, *o;
+	int     c, rc = 0;
+
+	snprintf (cur, sizeof cur, "%s", in);
+	for (; f && rc == 0; f = f->next) {
+		vms_tmp_name (next, sizeof next, "STAGE");
+		if (f->filter_func == NULL)
+			rc = vms_run_ext (f, cur, next);
+		else if (f->filter_func == filter_fix_linedirs) {
+			i = fopen (cur, "r");
+			o = fopen (next, "w");
+			if (i && o)
+				fix_linedirs_streams (i, o);
+			else {
+				vms_filter_error (_("cannot create temporary file"), next);
+				rc = -1;
+			}
+			if (i)
+				fclose (i);
+			if (o && fclose (o) != 0)
+				rc = -1;
+		}
+		else {
+			vms_filter_error (_("unexpected filter in chain"), "");
+			rc = -1;
+		}
+		if (strcmp (cur, in) != 0)
+			vms_delete_all (cur);
+		snprintf (cur, sizeof cur, "%s", next);
+	}
+	if (rc == 0) {
+		/* putc, not fwrite: to a record-oriented output (a terminal, a
+		   batch log) the C RTL writes each fwrite item as a record.  */
+		i = fopen (cur, "r");
+		if (i == NULL)
+			rc = -1;
+		else {
+			while ((c = getc (i)) != EOF)
+				putc (c, final);
+			fclose (i);
+		}
+	}
+	if (strcmp (cur, in) != 0)
+		vms_delete_all (cur);
+	return rc;
+}
+
+bool filter_apply_chain (struct filter * chain)
+{
+	if (!chain)
+		return true;
+	fflush (stdout);
+	vms_chain = chain;
+	vms_out_fd = dup (fileno (stdout));
+	vms_tmp_name (vms_raw_name, sizeof vms_raw_name, "RAW");
+	if (vms_out_fd < 0 || freopen (vms_raw_name, "w", stdout) == NULL)
+		flexfatal (_("cannot create temporary file for the filter chain"));
+	return true;
+}
+
+/* Run the filter chain over flex's output (OK: flex succeeded; otherwise
+   just clean up).  0 on success.  */
+int filter_vms_finish (bool ok)
+{
+	struct filter *tee = vms_chain;
+	char    c_name[80], h_name[80];
+	FILE   *in, *to_c, *to_h = NULL, *final;
+	int     rc = 0;
+
+	if (!tee)
+		return 0;
+	vms_chain = NULL;
+	if (!ok) {
+		close (vms_out_fd);
+		vms_delete_all (vms_raw_name);
+		return 0;
+	}
+	final = fdopen (vms_out_fd, "w");
+	if (tee->filter_func != filter_tee_header) {
+		/* filter_truncate() left no tee: run the chain as it is.  */
+		rc = vms_run_chain (tee, vms_raw_name, final);
+		fclose (final);
+		vms_delete_all (vms_raw_name);
+		return rc;
+	}
+	vms_tmp_name (c_name, sizeof c_name, "C");
+	vms_tmp_name (h_name, sizeof h_name, "H");
+	in = fopen (vms_raw_name, "r");
+	to_c = fopen (c_name, "w");
+	if (tee->extra)
+		to_h = fopen (h_name, "w");
+	if (!in || !to_c || (tee->extra && !to_h)) {
+		vms_filter_error (_("cannot create temporary file"), c_name);
+		rc = -1;
+	}
+	else
+		tee_header_streams (in, to_c, to_h);
+	if (in)
+		fclose (in);
+	if (to_c)
+		fclose (to_c);
+	if (to_h)
+		fclose (to_h);
+	if (rc == 0)
+		rc = vms_run_chain (tee->next, c_name, final);
+	if (fclose (final) != 0)
+		rc = -1;
+	if (rc == 0 && tee->extra) {
+		final = fopen ((char *) tee->extra, "w");
+		if (final == NULL) {
+			vms_filter_error (_("cannot create"), (char *) tee->extra);
+			rc = -1;
+		}
+		else {
+			rc = vms_run_chain (tee->next, h_name, final);
+			if (fclose (final) != 0)
+				rc = -1;
+		}
+	}
+	vms_delete_all (vms_raw_name);
+	vms_delete_all (c_name);
+	vms_delete_all (h_name);
+	return rc;
+}
